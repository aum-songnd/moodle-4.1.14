{{=
<% %>=}}
<!-- Add options to the context menu. -->
<core-navbar-buttons slot="end">
<core-context-menu>
<core-context-menu-item *ngIf="loaded && !hasOffline && isOnline" [priority]="700" [content]="'core.refresh' | translate" (action)="doRefresh($event)" [iconAction]="refreshIcon" [closeOnClick]="false"></core-context-menu-item>
<core-context-menu-item *ngIf="loaded && hasOffline && isOnline" [priority]="650" [content]="'core.settings.synchronizenow' | translate" (action)="synchronize(true, $event)" [iconAction]="syncIcon" [closeOnClick]="false"></core-context-menu-item>
</core-context-menu>
</core-navbar-buttons>
<core-course-module-description description="<% qaa.intro %>" component="mod_qaa" componentId="<% cmid %>"></core-course-module-description>


<ion-label>{{ 'plugin.mod_qaa.addquestion' | translate }}</ion-label>
<ion-item>
	<ion-textarea [(ngModel)]="question" name="question" ></ion-textarea>
</ion-item>
<button ion-button block color="light" core-site-plugins-call-ws-new-content name="mod_qaa_makequestion" [params]="{cmid: <% cmid %>, courseid: <% courseid %>, question:question }"  component="mod_qaa" method="mobile_course_view" [args]="{cmid: <% cmid %>, courseid: <% courseid %>}" confirmMessage samePage="true" >
	{{ 'plugin.mod_qaa.submit' | translate}}
</button>
