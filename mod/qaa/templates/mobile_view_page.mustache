<!-- Add options to the context menu. -->
<core-navbar-buttons slot="end">
<core-context-menu>
<core-context-menu-item *ngIf="loaded && !hasOffline && isOnline" [priority]="700" [content]="'core.refresh' | translate" (action)="doRefresh($event)" [iconAction]="refreshIcon" [closeOnClick]="false"></core-context-menu-item>
<core-context-menu-item *ngIf="loaded && hasOffline && isOnline" [priority]="650" [content]="'core.settings.synchronizenow' | translate" (action)="synchronize(true, $event)" [iconAction]="syncIcon" [closeOnClick]="false"></core-context-menu-item>
</core-context-menu>
</core-navbar-buttons>
<core-course-module-description description="<% qaa.intro %>" component="mod_qaa" componentId="<% cmid %>"></core-course-module-description>
<% question %>
<div>
    <b>{{ 'plugin.mod_qaa.answered' | translate:{$a:<% num_answered %>} }}</b>
    <ol>
        <%# list_answered %>
        <li>
            <b>{{ 'plugin.mod_qaa.week' | translate: {$a: { weekbegin_humandate: "<% weekbegin_humandate %>", weekend_humandate: "<% weekend_humandate %>"} }
            }}</b>
            <div>
                <ol start="<% startindex %>">
                    <%#qaap%>
                    <li>
                        <b>{{ 'plugin.mod_qaa.questiondetail' | translate: {$a: { student: "<% studentname %>", datetime: "<% timecreatedquestion_human %>"} }
                        }}</b>
                        <div><a core-site-plugins-new-content title="<% certificate.name %>" component="mod_qaa" method="mobile_single_question_view" [args]="{cmid: <% cmid %>, courseid: <% courseid %>, questionid: <% id %> }" samePage="true" ><% question %></a></div>
                        <b>{{ 'plugin.mod_qaa.answerdetail' | translate: {$a: { teacher: "<% teachername %>", datetime: "<% timecreatedanswer_human %>"} }
                        }}</b>
                        <div><% answer %></div>
                    </li>
                    <%/qaap%>
                </ol>
            </div>
        </li>
        <%/ list_answered %>
    </ol>
</div>
<div>
    <b>{{ 'plugin.mod_qaa.unanswered' | translate:{$a:<% num_unanswered %>} }}</b>
    <ol>
        <%# list_unanswered %>
        <li>
            <b>{{ 'plugin.mod_qaa.week' | translate: {$a: { weekbegin_humandate: "<% weekbegin_humandate %>", weekend_humandate: "<% weekend_humandate %>"} }
            }}</b>
            <div>
                <ol start="<% startindex %>">
                    <%#qaap%>
                    <li>
                        <b>{{ 'plugin.mod_qaa.questiondetail' | translate: {$a: { student: "<% studentname %>", datetime: "<% timecreatedquestion_human %>"} }
                        }}</b>
                        <div><a core-site-plugins-new-content title="<% certificate.name %>" component="mod_qaa" method="mobile_single_question_view" [args]="{cmid: <% cmid %>, courseid: <% courseid %>, questionid: <% id %> }" samePage="true" ><% question %></a></div>
                    </li>
                    <%/qaap%>
                </ol>
            </div>
        </li>
        <%/ list_unanswered %>
    </ol>
</div>


<%#show_makequest_btn%>
    <button (action)="doRefresh($event)" ion-button block type="submit" color="light" core-site-plugins-new-content title="<% certificate.name %>" component="mod_qaa" method="mobile_add_new_question_view" [args]="{cmid: <% cmid %>, courseid: <% courseid %>}" samePage="true">
        {{ 'plugin.mod_qaa.addquestion' | translate }}
    </button>
<%/show_makequest_btn%>

