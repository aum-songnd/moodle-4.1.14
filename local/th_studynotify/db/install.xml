<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/th_studynotify/db" VERSION="2026012900" COMMENT="DB schema for local_th_studynotify">
  <TABLES>
<TABLE NAME="local_th_studynotify_holiday" COMMENT="Holiday date ranges per course start batch">
    <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="batchstart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Course startdate this holiday applies to"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
    </FIELDS>
    <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
    </KEYS>
</TABLE>
  </TABLES>
</XMLDB>
