<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB
    PATH="local/th_ieltsquizaudio/db"
    VERSION="2026071500"
    COMMENT="XMLDB file for local_th_ieltsquizaudio"
>
    <TABLES>

        <TABLE
            NAME="local_th_ieltsquizaudio"
            COMMENT="IELTS audio settings for each quiz"
        >
            <FIELDS>

                <FIELD
                    NAME="id"
                    TYPE="int"
                    LENGTH="10"
                    NOTNULL="true"
                    SEQUENCE="true"
                />

                <FIELD
                    NAME="quizid"
                    TYPE="int"
                    LENGTH="10"
                    NOTNULL="true"
                    DEFAULT="0"
                />

                <FIELD
                    NAME="resumeoffset"
                    TYPE="int"
                    LENGTH="10"
                    NOTNULL="true"
                    DEFAULT="3"
                />

                <FIELD
                    NAME="timecreated"
                    TYPE="int"
                    LENGTH="10"
                    NOTNULL="true"
                    DEFAULT="0"
                />

                <FIELD
                    NAME="timemodified"
                    TYPE="int"
                    LENGTH="10"
                    NOTNULL="true"
                    DEFAULT="0"
                />

            </FIELDS>

            <KEYS>

                <KEY
                    NAME="primary"
                    TYPE="primary"
                    FIELDS="id"
                />

                <KEY
                    NAME="quizidfk"
                    TYPE="foreign"
                    FIELDS="quizid"
                    REFTABLE="quiz"
                    REFFIELDS="id"
                />

            </KEYS>

            <INDEXES>

                <INDEX
                    NAME="quizidunique"
                    UNIQUE="true"
                    FIELDS="quizid"
                />

            </INDEXES>

        </TABLE>

    </TABLES>
</XMLDB>