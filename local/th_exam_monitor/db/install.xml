<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/th_exam_monitor/db" VERSION="2025081100" COMMENT="XMLDB file for local_th_exam_monitor plugin"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">

    <TABLES>
        <TABLE NAME="local_th_exam_monitor" COMMENT="Stores teacher actions (warn, alert, suspend) for quiz attempts">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key" />
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID of the student" />
                <FIELD NAME="action_status" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Selected action" />
                <FIELD NAME="note" TYPE="text" NOTNULL="false" COMMENT="Teacher's note" />
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Time action was created" />
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="ID of the course" />
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id" />
                <KEY NAME="user_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id" />
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
