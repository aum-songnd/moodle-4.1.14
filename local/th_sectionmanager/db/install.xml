<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/th_sectionmanager/db" VERSION="20260423" COMMENT="XMLDB file for Moodle local/th_sectionmanager"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_th_sectionmanager_type" COMMENT="Lưu trữ danh mục các loại section">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Tên loại section"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Tên viết tắt (VD: LT, BT)"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_th_sectionmanager_map" COMMENT="Mapping giữa section và loại section">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID của khóa học"/>
        <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID của section"/>
        <FIELD NAME="typeid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="ID trỏ tới bảng type"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>