<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/th_online_exam_manager/db" VERSION="2025041401" COMMENT="Regrade requests">
    <TABLES>
        <TABLE NAME="th_exam_regrade_requests" COMMENT="Regrade requests table">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="reason" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="note" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0.00000" SEQUENCE="false" DECIMALS="5"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" DEFAULT="pending"/>
                <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NULLABLE="true"/>
                <FIELD NAME="timerequested" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timeprocessed" TYPE="int" LENGTH="10" NULLABLE="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="th_exam_regrade_assign" COMMENT="Regrade waiting assign table">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="timerequested" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
