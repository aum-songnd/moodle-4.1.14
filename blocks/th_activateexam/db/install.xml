<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/th_activateexam/db" VERSION="2025092500" COMMENT="Tables for block_th_activateexam">
    <TABLES>
        <TABLE NAME="block_th_activateexam_log" COMMENT="Lưu lịch sử phê duyệt quiz">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="action" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="approve|unapprove"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="oldavailability" TYPE="text" NOTNULL="false" COMMENT="Availability gốc trước khi approve"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
